# Ce fichier n'est partage qu'avec le compose qui se charge de distribuer les locals a chaque container
# le premier commentaire de chaque locals montre quels service vont en profiter

# service: docker compose (host) — nom de projet, préfixe des images/volumes
COMPOSE_PROJECT_NAME=better-intra

# service: backend — dev/prod flag (app/config.py)
ENVIRONMENT=development

# service: backend — signature des JWT (access/refresh). Obligatoire, pas de défaut dans le code.
# Générer : openssl rand -base64 48
# Algo + durées restent dans apps/server/app/config.py (HS256, 60 min / 30 jours).
JWT_SECRET=

# service: proxy, backend 
# adresse de base pour les redirect du host
DOMAIN_NAME=localhost:8443

# service: web
# chemin relatif vers /api (backend)
VITE_API_URL=/api

# service: db 
POSTGRES_USER=betterintra
POSTGRES_PASSWORD=betterintra
POSTGRES_DB=betterintra

# service: backend
# FORTY_TWO_REDIRECT_URI doit être *exactement* l'URI déclarée sur https://profile.intra.42.fr/oauth/applications
# et correspondre a DOMAIN_NAME + /api/oauth/callback
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FORTY_TWO_REDIRECT_URI=https://localhost:8443/api/auth/callback

# service: backend — cache API 42 (TTL)
REDIS_URL=redis://redis:6379/0

# --- Minimum requis pour que "make up" build (variables marquees ${...:?} dans compose.yml) ---
# DOMAIN_NAME=
# POSTGRES_PASSWORD=
# FORTY_TWO_CLIENT_ID=
# FORTY_TWO_CLIENT_SECRET=
# JWT_SECRET=
# (le reste a une valeur par defaut dans compose.yml si absent du .env :
#  POSTGRES_USER/POSTGRES_DB -> "betterintra", ENVIRONMENT -> "dev")
