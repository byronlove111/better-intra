# Shared / docker-compose
COMPOSE_PROJECT_NAME=better-intra

# Postgres container (image officielle postgres:16-alpine, lit ces 3 vars directement)
POSTGRES_USER=betterintra
POSTGRES_PASSWORD=betterintra
POSTGRES_DB=betterintra

# Frontend (public)
# Le navigateur doit toujours parler au proxy HTTPS (infra/nginx), jamais
# direct au backend en clair. (modification a debattre)
VITE_API_URL=https://localhost:8443

# Backend — doit rester aligné sur apps/server/.env.example : c'est CE fichier
# que le compose charge (env_file), et app/config.py a un défaut pour tout, donc
# une variable oubliée ici ne crashe pas, elle tourne juste en valeur de dev.
# NB: cette valeur "localhost" sert au dev hors Docker (Homebrew, cf. README).
# Dans compose.yml, DATABASE_URL est surchargée pour viser le service "db".
DATABASE_URL=postgresql+psycopg://betterintra:betterintra@localhost:5432/betterintra
# CORS_ORIGINS : origines autorisées à appeler l'API. Liste séparée par des
# virgules — convention maison, découpée dans config.py (pas du JSON).
#   http://localhost:5174   api-lab (port fixé dans apps/api-lab/vite.config.ts)
#   http://localhost:3000   front de Swan, à venir
#   https://localhost:8443  le proxy, si le front est un jour servi par lui
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# FRONTEND_URL : où /auth/callback renvoie le navigateur après le lien 42.
# Une seule valeur, pas une liste.
FRONTEND_URL=http://localhost:5174
ENVIRONMENT=development

# JWT — obligatoire : sans surcharge, l'API tourne avec le secret de dev en dur
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 42 OAuth (never commit real values — remplir dans .env, jamais ici)
# FORTY_TWO_REDIRECT_URI doit être *exactement* l'URI déclarée sur
# https://profile.intra.42.fr/oauth/applications
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FORTY_TWO_REDIRECT_URI=http://localhost:8000/auth/callback

# Public API (clés API par utilisateur)
API_KEY_RATE_LIMIT_PER_MINUTE=60
