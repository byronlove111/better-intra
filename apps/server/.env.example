ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://betterintra:betterintra@localhost:5432/betterintra
CORS_ORIGINS=http://localhost:3000

# JWT (change before any real auth)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 42 OAuth (never commit real values — copy to apps/server/.env)
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FORTY_TWO_REDIRECT_URI=http://localhost:8000/auth/callback
